    "heat-pump.html": {
      "settings": {
        "title": "חימום בריכה באמצעות משאבת חום | היט סיסטם",
        "order": "6",
        "meta_descr": "גלה את הכוח של משאבות חום – פתרון חכם, חסכוני ויעיל לחימום בריכות בכל עונות השנה. בהיט סיסטם תיהנו מהתקנה מקצועית, אחריות מלאה ומוצרים מהמותגים המובילים בעולם.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://heat-system.co.il/heat-pump.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"היט סיסטם\">\n<meta property=\"og:url\" content=\"https://heat-system.co.il/heat-pump.html\">\n<meta property=\"og:title\" content=\"חימום בריכה באמצעות משאבת חום | היט סיסטם\">\n<meta property=\"og:description\" content=\"גלה את הכוח של משאבות חום – פתרון חכם, חסכוני ויעיל לחימום בריכות בכל עונות השנה. בהיט סיסטם תיהנו מהתקנה מקצועית, אחריות מלאה ומוצרים מהמותגים המובילים בעולם.\">\n<meta property=\"og:image\" content=\"https://heat-system.co.il/assets/images/hero-heat-pump.jpeg\">",
        "footer_custom": "",
        "html_before": ""
      },
