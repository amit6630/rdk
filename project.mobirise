    "index.html": {
      "settings": {
        "main": true,
        "title": "היט סיסטם | חימום תת רצפתי, חימום בריכות ומערכות חימום למקוואות",
        "meta_descr": "היט סיסטם מציעה פתרונות חימום מתקדמים ומותאמים אישית לבריכות, מקוואות ורצפות – עם שירות מקצועי, ניסיון מוכח ומערכות חכמות שחוסכות בהוצאות. צרו קשר לייעוץ חינם!",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://heat-system.co.il/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"היט סיסטם\">\n<meta property=\"og:url\" content=\"https://heat-system.co.il/\">\n<meta property=\"og:title\" content=\"היט סיסטם | חימום תת רצפתי, חימום בריכות ומערכות חימום למקוואות\">\n<meta property=\"og:description\" content=\"היט סיסטם מציעה פתרונות חימום מתקדמים ומותאמים אישית לבריכות, מקוואות ורצפות – עם שירות מקצועי, ניסיון מוכח ומערכות חכמות שחוסכות בהוצאות. צרו קשר לייעוץ חינם!\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"HVACBusiness\", \"@id\": \"https://heat-system.co.il/#business\", \"name\": \"היט סיסטם\", \"alternateName\": \"Heat System\", \"url\": \"https://heat-system.co.il/\", \"logo\": \"https://heat-system.co.il/assets/images/logo-heat-system.jpg\", \"image\": \"https://heat-system.co.il/assets/images/index-meta.jpg\", \"description\": \"תכנון, אספקה והתקנה של מערכות חימום: חימום תת רצפתי, חימום בריכות, משאבות חום, קולטי שמש ומערכות חימום למקוואות.\", \"telephone\": \"+972-54-750-2018\", \"email\": \"heatsystem.il@gmail.com\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"משה ברזאני 4\", \"addressLocality\": \"קרית גת\", \"postalCode\": \"8213710\", \"addressCountry\": \"IL\"}, \"contactPoint\": [{\"@type\": \"ContactPoint\", \"telephone\": \"+972-54-750-2018\", \"contactType\": \"sales\", \"availableLanguage\": \"he\"}, {\"@type\": \"ContactPoint\", \"telephone\": \"+972-77-656-1067\", \"contactType\": \"customer service\", \"availableLanguage\": \"he\"}], \"sameAs\": [\"https://www.facebook.com/share/1bY6SCu7Tu/\", \"https://www.instagram.com/heatsystem.il\"], \"makesOffer\": [{\"@type\": \"Offer\", \"itemOffered\": {\"@type\": \"Service\", \"name\": \"חימום תת רצפתי\", \"url\": \"https://heat-system.co.il/underfloor-heating.html\"}}, {\"@type\": \"Offer\", \"itemOffered\": {\"@type\": \"Service\", \"name\": \"חימום בריכות\", \"url\": \"https://heat-system.co.il/pool-heating.html\"}}, {\"@type\": \"Offer\", \"itemOffered\": {\"@type\": \"Service\", \"name\": \"חימום בריכה באמצעות משאבת חום\", \"url\": \"https://heat-system.co.il/heat-pump.html\"}}, {\"@type\": \"Offer\", \"itemOffered\": {\"@type\": \"Service\", \"name\": \"חימום בריכה באמצעות קולטי שמש\", \"url\": \"https://heat-system.co.il/solar-collectors.html\"}}, {\"@type\": \"Offer\", \"itemOffered\": {\"@type\": \"Service\", \"name\": \"מערכות חימום למקוואות\", \"url\": \"https://heat-system.co.il/mikveh-heating.html\"}}]}</script>",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/logo-heat-system.jpg"
      },
