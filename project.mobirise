                "padding-bottom": "(@paddingBottom * 0rem)"
              }
            },
            ".title-wrapper": {
              "padding": "0 15%",
              "@media (max-width: 992px)": {
                "padding": "0",
                "& when not (@fullScreen)": {
                  "padding-top": "(@paddingTop * 0rem)",
                  "padding-bottom": "(@paddingBottom * 0rem)"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "50px"
              },
              ".mbr-text": {
                "margin-bottom": "50px"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
