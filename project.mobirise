        {
          "_name": "hs-card",
          "_sourceTheme": "startm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "background-image": "radial-gradient(1200px 520px at 85% -10%, rgba(224, 96, 58, .18), transparent 60%), radial-gradient(900px 600px at -10% 110%, rgba(127, 25, 36, .14), transparent 60%)",
            "direction": "rtl",
            "color": "#2a1316",
            ".hs-layout": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "40px",
              "align-items": "center",
              "max-width": "1040px",
              "margin": "0 auto"
            },
            "@media (min-width: 992px)": {
              ".hs-layout": {
                "grid-template-columns": "1.05fr 1fr",
                "gap": "56px"
              }
            },
            ".hs-stage": {
              "display": "grid",
              "justify-items": "center",
              "gap": "18px",
              "position": "relative"
            },
            ".hs-flip-toggle": {
              "position": "absolute",
              "opacity": "0",
              "width": "1px",
              "height": "1px",
              "pointer-events": "none"
            },
            ".hs-tilt": {
              "display": "block",
              "perspective": "1400px",
              "width": "100%",
              "max-width": "440px",
              "margin": "0",
              "cursor": "pointer"
            },
            ".hs-bcard": {
              "display": "block",
              "position": "relative",
              "aspect-ratio": "1.62",
              "transform-style": "preserve-3d",
              "transition": "transform .9s cubic-bezier(.2, .8, .2, 1)"
            },
            ".hs-flip-toggle:checked ~ .hs-tilt .hs-bcard": {
              "transform": "rotateY(180deg)"
            },
            ".hs-face": {
              "position": "absolute",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "left": "0",
              "border-radius": "22px",
              "overflow": "hidden",
              "backface-visibility": "hidden",
              "-webkit-backface-visibility": "hidden",
              "box-shadow": "0 30px 60px -20px rgba(74, 14, 21, .45)"
            },
            ".hs-face--front": {
              "background": "#ffffff",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "justify-content": "flex-start",
              "text-align": "center"
            },
            ".hs-face--front img": {
              "width": "62%",
              "max-width": "250px",
              "height": "auto",
              "margin-top": "3%",
              "border-radius": "0"
            },
            ".hs-front-tag": {
              "position": "absolute",
              "bottom": "0",
              "left": "0",
              "right": "0",
              "height": "30%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "padding": "0 16px",
              "color": "#ffffff",
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": "1rem",
              "background": "linear-gradient(100deg, @darkColor, @mainColor 55%, @accentColor)"
            },
            ".hs-face--back": {
              "transform": "rotateY(180deg)",
              "background": "linear-gradient(140deg, @darkColor, @mainColor)",
              "color": "#ffffff",
              "display": "flex",
              "align-items": "center",
              "gap": "20px",
              "padding": "22px 24px"
            },
            ".hs-qr": {
              "flex": "none",
              "background": "#ffffff",
              "border-radius": "14px",
              "padding": "10px",
              "width": "140px"
            },
            ".hs-qr svg": {
              "display": "block",
              "width": "100%",
              "height": "auto"
            },
            ".hs-back-text": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "2px",
              "text-align": "right",
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": ".9rem"
            },
            ".hs-back-line[dir=\"ltr\"]": {
              "text-align": "right"
            },
            ".hs-back-title": {
              "font-family": "'Heebo-Bold', sans-serif",
              "font-size": "1.05rem",
              "margin-bottom": "6px"
            },
            ".hs-flip-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "margin": "0",
              "border": "1px solid rgba(127, 25, 36, .2)",
              "color": "@mainColor",
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": "1rem",
              "padding": "8px 18px",
              "border-radius": "999px",
              "cursor": "pointer",
              "background": "rgba(255, 255, 255, .6)"
            },
            ".hs-flip-btn:hover": {
              "background": "#ffffff"
            },
            ".hs-flip-toggle:focus-visible ~ .hs-flip-btn": {
              "outline": "3px solid @accentColor",
              "outline-offset": "3px"
            },
            ".hs-to-front": {
              "display": "none"
            },
            ".hs-flip-toggle:checked ~ .hs-flip-btn .hs-to-front": {
              "display": "inline"
            },
            ".hs-flip-toggle:checked ~ .hs-flip-btn .hs-to-qr": {
              "display": "none"
            },
            ".hs-eyebrow": {
              "margin": "0",
              "color": "@accentColor",
              "font-family": "'Heebo-Bold', sans-serif",
              "letter-spacing": ".14em",
              "font-size": ".8rem",
              "text-align": "right"
            },
            ".hs-title": {
              "margin": "6px 0 4px",
              "font-family": "'Heebo-Bold', sans-serif",
              "font-size": "2.8rem",
              "line-height": "1.1",
              "color": "@darkColor",
              "text-align": "right"
            },
            ".hs-lead": {
              "margin": "0 0 22px",
              "color": "#7a6266",
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": "1.05rem",
              "text-align": "right"
            },
            ".hs-actions": {
              "display": "grid",
              "grid-template-columns": "repeat(2, 1fr)",
              "gap": "12px"
            },
            ".hs-act": {
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "padding": "14px 16px",
              "min-height": "64px",
              "border-radius": "16px",
              "text-decoration": "none !important",
              "color": "#2a1316 !important",
              "background": "#ffffff",
              "border": "1px solid rgba(127, 25, 36, .14)",
              "box-shadow": "0 6px 18px -12px rgba(74, 14, 21, .35)",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".hs-act:hover": {
              "transform": "translateY(-2px)",
              "border-color": "rgba(127, 25, 36, .35)",
              "box-shadow": "0 14px 26px -14px rgba(74, 14, 21, .45)"
            },
            ".hs-ic": {
              "flex": "none",
              "width": "40px",
              "height": "40px",
              "border-radius": "12px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "rgba(127, 25, 36, .08)",
              "color": "@mainColor",
              "font-size": "20px"
            },
            ".hs-act-text": {
              "display": "flex",
              "flex-direction": "column",
              "min-width": "0",
              "text-align": "right"
            },
            ".hs-act-title": {
              "font-family": "'Heebo-Bold', sans-serif",
              "font-size": ".98rem"
            },
            ".hs-act-sub": {
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": ".82rem",
              "color": "#7a6266",
              "text-align": "right",
              "overflow-wrap": "anywhere"
            },
            ".hs-act--primary": {
              "background": "linear-gradient(100deg, @darkColor, @mainColor)",
              "color": "#ffffff !important",
              "border-color": "transparent"
            },
            ".hs-act--primary .hs-ic": {
              "background": "rgba(255, 255, 255, .14)",
              "color": "#ffffff"
            },
            ".hs-act--primary .hs-act-sub": {
              "color": "rgba(255, 255, 255, .8)"
            },
            ".hs-act--wa .hs-ic": {
              "background": "rgba(37, 211, 102, .12)",
              "color": "#128c4a"
            },
            ".hs-sub": {
              "margin": "26px 0 10px",
              "font-family": "'Heebo-Bold', sans-serif",
              "font-size": "1rem",
              "color": "@darkColor",
              "text-align": "right"
            },
            ".hs-chips": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px"
            },
            ".hs-chips a": {
              "padding": "7px 14px",
              "border-radius": "999px",
              "background": "#ffffff",
              "border": "1px solid rgba(127, 25, 36, .14)",
              "color": "#2a1316 !important",
              "text-decoration": "none !important",
              "font-family": "'Heebo-Medium', sans-serif",
              "font-size": ".92rem"
            },
            ".hs-chips a:hover": {
              "border-color": "@mainColor",
              "color": "@mainColor !important"
            },
            ".hs-social": {
              "display": "flex",
              "gap": "10px"
            },
            ".hs-social a": {
              "width": "46px",
              "height": "46px",
              "border-radius": "50%",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#ffffff",
              "border": "1px solid rgba(127, 25, 36, .14)",
              "color": "@mainColor !important",
              "font-size": "20px",
              "text-decoration": "none !important"
            },
            ".hs-social a:hover": {
              "background": "@mainColor",
              "color": "#ffffff !important"
            },
            "@media (max-width: 767px)": {
              ".hs-title": {
                "font-size": "2.1rem"
              },
              ".hs-qr": {
                "width": "108px"
              },
              ".hs-face--back": {
                "padding": "16px",
                "gap": "14px"
              },
              ".hs-back-text": {
                "font-size": ".8rem"
              }
            },
            "@media (max-width: 380px)": {
              ".hs-actions": {
                "grid-template-columns": "1fr"
              }
            },
            "@media (prefers-reduced-motion: reduce)": {
              ".hs-bcard": {
                "transition": "none"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"hs-card\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"8\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <header>Colors</header>\n    <input type=\"color\" title=\"Main\" name=\"mainColor\" value=\"#7f1924\">\n    <input type=\"color\" title=\"Dark\" name=\"darkColor\" value=\"#4a0e15\">\n    <input type=\"color\" title=\"Accent\" name=\"accentColor\" value=\"#e0603a\">\n    <input type=\"color\" title=\"Background\" name=\"bgColor\" value=\"#fbf6f1\">\n  </mbr-parameters>\n  <div class=\"container\">\n    <div class=\"hs-layout\">\n      <div class=\"hs-stage\">\n        <input type=\"checkbox\" id=\"hsFlip\" class=\"hs-flip-toggle\" aria-label=\"הפיכת הכרטיס לקוד QR\">\n        <label for=\"hsFlip\" class=\"hs-tilt\">\n          <span class=\"hs-bcard\">\n            <span class=\"hs-face hs-face--front\">\n              <img src=\"@PROJECT_PATH@/assets/images/logo-heat-system.jpg\" alt=\"היט סיסטם\" width=\"322\" height=\"258\">\n              <span class=\"hs-front-tag\" mbr-text data-app-selector=\".hs-front-tag\">תכנון, אספקה והתקנה של מערכות חימום</span>\n            </span>\n            <span class=\"hs-face hs-face--back\">\n              <span class=\"hs-qr\"><svg role=\"img\" aria-label=\"קוד QR לכרטיס הביקור\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 29 29\" shape-rendering=\"crispEdges\"><path fill=\"#4a0e15\" d=\"M0 0h1v1h-1zM1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM4 0h1v1h-1zM5 0h1v1h-1zM6 0h1v1h-1zM9 0h1v1h-1zM10 0h1v1h-1zM12 0h1v1h-1zM14 0h1v1h-1zM17 0h1v1h-1zM18 0h1v1h-1zM19 0h1v1h-1zM20 0h1v1h-1zM22 0h1v1h-1zM23 0h1v1h-1zM24 0h1v1h-1zM25 0h1v1h-1zM26 0h1v1h-1zM27 0h1v1h-1zM28 0h1v1h-1zM0 1h1v1h-1zM6 1h1v1h-1zM8 1h1v1h-1zM9 1h1v1h-1zM12 1h1v1h-1zM13 1h1v1h-1zM18 1h1v1h-1zM1