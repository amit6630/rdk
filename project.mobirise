              "img": {
                "width": "auto",
                "display": "inline-block"
              }
            },
            "@media (max-width: 767px)": {
              ".days-column": {
                "padding-right": "0 !important"
              },
              ".hours-column": {
                "max-width": "50% !important"
              },
              ".opening-hours": {
                "padding-bottom": "48px !important"
              }
            },
            ".form-title, .btn-row": {
              "color": "#7f1924"
            },
            ".follow-title, .social-list, .logo": {
              "color": "#7f1924"
            },
            ".address-title, .address-block": {
              "color": "#7f1924"
            },
