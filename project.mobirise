              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar-dropdown": {
                "padding": "0 1rem"
              }
            },
            ".navbar": {
              "position": "static !important",
              "min-height": "77px",
              "transition": "0.2s",
              "background": "@menuBgColor",
              "display": "flex",
              "flex-direction": "column",
              "&.opened": {
                "transition": "all 0.2s",
