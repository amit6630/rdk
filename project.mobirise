            ".card-box-overlay": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "10",
              "background": "linear-gradient(to bottom, transparent, #000000)",
              "mix-blend-mode": "multiply",
              "transform": "matrix(1, 0, 0, 1, 0, 1)"
            },
            ".card-title": {
              "width": "100%",
              "margin-bottom": "0",
              "color": "#FCF0D5",
              "position": "relative",
              "z-index": "11"
