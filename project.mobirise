        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://heat-system.co.il/about.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"היט סיסטם\">\n<meta property=\"og:url\" content=\"https://heat-system.co.il/about.html\">\n<meta property=\"og:title\" content=\"אודות | היט סיסטם\">\n<meta property=\"og:description\" content=\"היט סיסטם פועלת כבר למעלה מ־10 שנים ומתמחה בהתקנת מערכות חימום מתקדמות, שירות מעולה ופתרונות חכמים שחוסכים ללקוחות אלפי שקלים בשנה. היכרות עם התחום והקפדה על איכות.\">\n<meta property=\"og:image\" content=\"https://heat-system.co.il/assets/images/index-meta.jpg\">",
