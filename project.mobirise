    "solar-collectors.html": {
      "settings": {
        "title": "חימום בריכה באמצעות קולטי שמש | היט סיסטם",
        "order": "5",
        "meta_descr": "חממו את הבריכה שלכם עם אנרגיית השמש! מערכות סולאריות מתקדמות מבית היט סיסטם מספקות חום טבעי וחיסכון של עד 80% בעלויות החשמל. פתרון אידיאלי לחצרות ובתי מלון.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://heat-system.co.il/solar-collectors.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"היט סיסטם\">\n<meta property=\"og:url\" content=\"https://heat-system.co.il/solar-collectors.html\">\n<meta property=\"og:title\" content=\"חימום בריכה באמצעות קולטי שמש | היט סיסטם\">\n<meta property=\"og:description\" content=\"חממו את הבריכה שלכם עם אנרגיית השמש! מערכות סולאריות מתקדמות מבית היט סיסטם מספקות חום טבעי וחיסכון של עד 80% בעלויות החשמל. פתרון אידיאלי לחצרות ובתי מלון.\">\n<meta property=\"og:image\" content=\"https://heat-system.co.il/assets/images/hero-solar-collectors.jpeg\">",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky",
              "top": "0",
              "z-index": "11"
            },
            ".navbar-dropdown": {
              "position": "relative !important",
              "top": "0",
              "left": "0",
              "padding": "0.5rem 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar-dropdown": {
                "padding": "0 1rem"
              }
            },
            ".navbar": {
              "position": "static !important",
              "min-height": "77px",
              "transition": "0.2s",
              "background": "@menuBgColor",
              "display": "flex",
              "flex-direction": "column",
              "&.opened": {
                "transition": "all 0.2s",
                "background": "@menuBgColor !important"
              },
              ".dropdown-item": {
                "transition": "all 0.2s",
                "padding": "0.3rem 1.5rem",
                "border-bottom": "1px solid darken(@dropdownColor, 10%)",
                "color": "#7f1924",
                "background": "@dropdownColor !important",
                "&:hover": {
                  "padding-left": "2rem"
                },
                "&:focus": {
                  "border": {
                    "outline": "none"
                  }
                }
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              ".dropdown-menu": {
                "min-width": "300px",
                "padding": "3px 0 0 0",
                "box-shadow": "5px 5px 18px 0px rgba(217, 220, 242, 0.98)",
                "background": "transparent !important",
                "& > .dropdown-item:first-child": {
                  "border-top": "2px solid @primaryColor"
