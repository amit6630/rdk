              "background-image": "linear-gradient(to bottom, #ffffff 0%, rgba(255, 255, 255, 0) 60%), linear-gradient(to bottom, rgba(152, 152, 152, 0) 60%, #f7f7f7 90%), url(@bg-value)",
              "background-size": "cover",
