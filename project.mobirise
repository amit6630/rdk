              "transition": "0.2s"
            },
            ".social": {
              "display": "flex",
              "flex-direction": "row",
              "margin-left": "2rem"
            },
            ".social-2": {
              "display": "flex",
              "flex-direction": "row",
              "margin-right": "1.5rem"
            }
